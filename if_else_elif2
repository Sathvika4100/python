age = int(input("Enter the age : "))  #if else and elif are python conditions
if age > 0 and age <= 20:             # and is a logical operator.
    print("Teenage")                  #<,>,<=,>= are comparision operators.  
elif age > 20 and age < 40:
    print("Adult age")
elif age > 40 and age < 60:
    print(age > 40 and age < 60)
elif age > 60 and age < 80:
    print("Senior age")
else:
    print("Out Of Range")
