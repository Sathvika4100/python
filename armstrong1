# Take input from user
num = int(input("Enter a number: "))

# Store original number
original_num = num

# Count number of digits
num_digits = len(str(num)) ##len is a keyword which defines the number of digits. 

# Calculate sum of digits raised to power of number of digits
sum_of_powers = 0                              

while num > 0:
    digit = num % 10
    sum_of_powers += digit ** num_digits
    num = num // 10

# Check if Armstrong
if sum_of_powers == original_num:
      print(original_num, "is an Armstrong number.")
else:
    print(original_num, "is not an Armstrong number.")
