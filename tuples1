# numbers[0] = 100
# TypeError: 'tuple' object does not support item assignment

print("\n--------------------------")

# 17. Tuple as Dictionary Key
locations = {
    (10, 20): "Home",
    (30, 40): "Office"
}

print("Dictionary with Tuple Keys:")
print(locations)
print("Location at (10,20):", locations[(10, 20)])

print("\n--------------------------")

print("Program Completed Successfully!")
