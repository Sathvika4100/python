choice = int(input("Enter 1 for Armstrong Number\nEnter 2 for factorise\nEnter 3 for Palindrome\nEnter your choice : "))
if choice == 1:
    num = int(input("Enter a number of your choice : "))
    original_num = num
    sum_of_powers = 0
    num_digits = len(str(num))
    while num > 0:
        digit = num % 10
        sum_of_powers += digit ** num_digits
        num = num // 10
        if sum_of_powers == original_num:
            print(original_num,"is an Armstrong number.")
        else:
            print(original_num,"is not an Armstrong number.")
elif choice == 2:
    num1 = int(input("Enter a number of your choice : "))
    total = 1
    for i in range(1,num1+1):
        print(i)
        total = total * i
        print(f"the factorial of {i} is {total}")
elif choice == 3:
    num2 = int(input("Enter a number of your choice : "))
    org = num2
    reverse = 0
    while num2 > 0:
        digit = num2 % 10
        reverse = reverse * 10 + digit
        num2 = num2 // 10
    if org == reverse:
        print(org,"is a palindrome number.")
    else:
        print(org,"is not a palindrome number.")
