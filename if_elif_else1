num1 = int(input("Enter number1 : "))
num2 = int(input("Enter number2 : "))
choice = int(input("Enter your choice of operators (-,+,*,/,%) in integer : "))
if choice == 1:
    print(f"{num1}+{num2} = {num1+num2}")
elif choice == 2:
    print(f"{num1}-{num2} = {num1-num2}")
elif choice == 3:
    print(f"{num1}*{num2} = {num1*num2}")
elif choice == 4:
    print(f"{num1}/{num2} = {num1/num2}")
elif choice == 5:
    print(f"{num1}%{num2} = {num1%num2}")
else :
    print("Out Of Range")
