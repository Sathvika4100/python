name = (input("Student's name : "))

eng = int(input("Enter your marks in english : "))
math = int(input("Enter your marks in maths : "))
sci = int(input("Enter your marks in science : "))
python = int(input("Enter your marks in python : "))
geo = int(input("Enter your marks in geography : "))



print("Student name : ",name)

total = eng+math+sci+python+geo
print(f"Total : {total}")

percentage = total/500*100

print("Student's Percentage : ",percentage)
if percentage < 100 and percentage >= 90:
    print("Student's grade is : O")
elif percentage < 90 and percentage >= 80:
    print("Student's grade is : A")
elif percentage < 80 and percentage >= 70:
    print("Student's grade is : B")
elif percentage < 70 and percentage >= 60:
    print("Student's grade is : C")
elif percentage < 60 and percentage >= 50:
    print("Student's grade is D")
elif percentage < 50 and percentage >= 35:
    print("Student's garde is : E")
elif percentage < 35 and percentage >= 0:
    print("Fail")
else:
    print("Out Of Range")
