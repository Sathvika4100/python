def add(n1,n2):
    print(f"{n1}+{n2}={n1+n2}")


def subtract(n1,n2):
    print(f"{n1}-{n2}={n1-n2}")

def multiply(n1,n2):
    print(f"{n1}*{n2}={n1*n2}")

def mod(n1,n2):
    print(f"{n1}%{n2}={n1%n2}")

def division():
    print(f"{n1}/{n2}={n1/n2}") #defined how each function will work.

int1 = int(input("Enter the first number : "))
int2 = int(input("Enter the second number : "))

choice = int(input("""Enter 1 for addition\nEnter 2 for subtraction
                   \nEnter 3 for multiplication\nEnter 4 for division
Enter your choice : \n"""))
if choice == 1:
    add(int1,int2)
elif choice == 2:
    subtract(int1,int2)
elif choice == 3:
    multiply(int1,int2)
elif choice == 4:
    mod(int1,int2)
elif choice == 5:
    division(int1,int2)
else:
    print("Enter again")
