import math


def square_root(num1):
    print("The Square Root is:",math.sqrt(num1))


def power(num1,num2):
    print("The power of num1 is:",math.pow(num1,num2))


def ceiling(num1):
    print("Ceiling of num1 is:",math.ceil(num1))

def floor(num1):
    print("The floor value of num1 is:",math.floor(num1))

def absolute(num1):
    print("The absolute value fof num1 is:",abs(-num1))

def factorial(num1):
    print("The factorial of num1:",math.factorial(num1))

def radians(num1):
    print("The radians of num1 is:",math.radians(num1))

def sin(num1):
    print("The sin of num1 is:",math.sin(num1))

def cos(num1):
    print("The cos of num1 is:",math.cos(num1))

def tan(num1):
    print("The tan of num1 is:",math.tan(num1))

def natural_log(num1):
    print("The natural log of num1 is:",math.log(num1))

def Base10_log(num1):
    print("The Base 10 log of num1 is:",math.log10(num1))

def expo(num1):
    print("The Exponential value of num1 is:",math.exp(num1))

def PI():
    print("The value of PI is:",math.pi)

def e():
    print("The value of e is:",math.e)

def Greatest_Common_Divisor(num1,num2):
    print("The Greatest Common Divisor of num1 is:",math.gcd(num1,num2))
